# Fan et al. TITS 2024: polytope separation (12), five-state model, (26)-(27).
param N integer >=2;param M integer >=0;param E integer >=0;
param first{1..M} integer;param last{1..M} integer;param ox{1..E};param oy{1..E};
param bx{1..4};param body_y{1..4};param boundary{1..6};
param radius;param support_tol;param lw;param vmax;param amax;param phimax;param wmax;
param min_time;param max_time;param time_weight;param acceleration_weight;param rate_weight;
var h >=min_time/N,<=max_time/N;
var x{0..N};var y{0..N};var theta{0..N};var v{0..N}>=-vmax,<=vmax;var phi{0..N}>=-phimax,<=phimax;
var a{0..N-1}>=-amax,<=amax;var omega{0..N-1}>=-wmax,<=wmax;
var vm{i in 0..N-1}=v[i]+h/2*a[i];var ve{i in 0..N-1}=v[i]+h*a[i];
var pm{i in 0..N-1}=phi[i]+h/2*omega[i];var pe{i in 0..N-1}=phi[i]+h*omega[i];
var th2{i in 0..N-1}=theta[i]+h/2*v[i]*tan(phi[i])/lw;
var th3{i in 0..N-1}=theta[i]+h/2*vm[i]*tan(pm[i])/lw;
var th4{i in 0..N-1}=theta[i]+h*vm[i]*tan(pm[i])/lw;
minimize cost:h*sum{i in 0..N-1}(time_weight+acceleration_weight*a[i]^2+rate_weight*omega[i]^2);
subject to x_flow{i in 0..N-1}:x[i+1]=x[i]+h/6*(v[i]*cos(theta[i])+2*vm[i]*cos(th2[i])+2*vm[i]*cos(th3[i])+ve[i]*cos(th4[i]));
subject to y_flow{i in 0..N-1}:y[i+1]=y[i]+h/6*(v[i]*sin(theta[i])+2*vm[i]*sin(th2[i])+2*vm[i]*sin(th3[i])+ve[i]*sin(th4[i]));
subject to theta_flow{i in 0..N-1}:theta[i+1]=theta[i]+h/(6*lw)*(v[i]*tan(phi[i])+4*vm[i]*tan(pm[i])+ve[i]*tan(pe[i]));
subject to velocity_flow{i in 0..N-1}:v[i+1]=ve[i];
subject to steering_flow{i in 0..N-1}:phi[i+1]=pe[i];
subject to start_x:x[0]=boundary[1];subject to start_y:y[0]=boundary[2];
subject to start_theta:theta[0]=boundary[3];
subject to start_v:v[0]=0;subject to start_phi:phi[0]=0;
subject to goal_x:x[N]=boundary[4];subject to goal_y:y[N]=boundary[5];
subject to goal_theta:theta[N]=boundary[6];
subject to goal_v:v[N]=0;subject to goal_phi:phi[N]=0;
var px{i in 0..N,j in 1..4}=x[i]+cos(theta[i])*bx[j]-sin(theta[i])*body_y[j];
var py{i in 0..N,j in 1..4}=y[i]+sin(theta[i])*bx[j]+cos(theta[i])*body_y[j];
var nx{0..N-1,1..M};var ny{0..N-1,1..M};var mu{0..N-1,1..M};
# Uniform-in-time bounds for the acceleration of each physical body corner.
var sv{0..N-1}>=0,<=vmax;var sp{0..N-1}>=0,<=phimax;
var sa{0..N-1}>=0,<=amax;var sw{0..N-1}>=0,<=wmax;var reserve{0..N-1}>=support_tol;
subject to abs_speed{i in 0..N-1,s in 0..1,k in {-1,1}}:sv[i]>=k*v[i+s];
subject to abs_steering{i in 0..N-1,s in 0..1,k in {-1,1}}:sp[i]>=k*phi[i+s];
subject to abs_accel{i in 0..N-1,k in {-1,1}}:sa[i]>=k*a[i];
subject to abs_rate{i in 0..N-1,k in {-1,1}}:sw[i]>=k*omega[i];
var curvature{i in 0..N-1}=tan(sp[i])/lw;
var envelope{i in 0..N-1}=sa[i]+sv[i]^2*curvature[i]+radius*(sa[i]*curvature[i]+sv[i]*sw[i]/(lw*cos(sp[i])^2)+(sv[i]*curvature[i])^2);
subject to flow_reserve{i in 0..N-1}:reserve[i]>=h^2/8*envelope[i]+support_tol;
subject to linear_reserve{i in 0..N-1}:reserve[i]>=radius/8*(theta[i+1]-theta[i])^2+support_tol;
subject to nonzero_normal{i in 0..N-1,j in 1..M}:nx[i,j]^2+ny[i,j]^2=1;
subject to body_side{i in 0..N-1,j in 1..M,k in 1..4,s in 0..1}:nx[i,j]*px[i+s,k]+ny[i,j]*py[i+s,k]>=mu[i,j]+reserve[i];
subject to obstacle_side{i in 0..N-1,j in 1..M,k in first[j]..last[j]}:nx[i,j]*ox[k]+ny[i,j]*oy[k]<=mu[i,j];
