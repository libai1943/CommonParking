# Chen et al., TVT 2025: explicit Euler, frozen signed-area planes and trust boxes.
param N integer >=3;param NE integer >=0;param NO integer >=0;
param lw;param vmax;param amax;param phimax;param wmax;param hmin;param hmax;param wa;param ww;
param boundary{1..6};param rx{1..N};param ry{1..N};param rt{1..N};param dr{1..N};param da{1..N};
param ei{1..NE} integer;param ex{1..NE};param ey{1..NE};param ea{1..NE};param eb{1..NE};param ec{1..NE};
param oi{1..NO} integer;param ox{1..NO};param oy{1..NO};param oa{1..NO};param ob{1..NO};param oc{1..NO};
var x{1..N};var y{1..N};var theta{1..N};var v{1..N}>=-vmax,<=vmax;var phi{1..N}>=-phimax,<=phimax;
var a{1..N}>=-amax,<=amax;var omega{1..N}>=-wmax,<=wmax;var h{1..N-1}>=hmin,<=hmax;
minimize cost:sum{i in 1..N-1}h[i]*(1+wa*a[i]^2+ww*omega[i]^2);
subject to x_flow{i in 1..N-1}:x[i+1]=x[i]+h[i]*v[i]*cos(theta[i]);
subject to y_flow{i in 1..N-1}:y[i+1]=y[i]+h[i]*v[i]*sin(theta[i]);
subject to theta_flow{i in 1..N-1}:theta[i+1]=theta[i]+h[i]*v[i]*tan(phi[i])/lw;
subject to v_flow{i in 1..N-1}:v[i+1]=v[i]+h[i]*a[i];
subject to phi_flow{i in 1..N-1}:phi[i+1]=phi[i]+h[i]*omega[i];
subject to sx:x[1]=boundary[1];subject to sy:y[1]=boundary[2];
subject to st:atan2(sin(theta[1]-boundary[3]),cos(theta[1]-boundary[3]))=0;
subject to sv:v[1]=0;subject to sp:phi[1]=0;subject to sa:a[1]=0;subject to sw:omega[1]=0;
subject to gx:x[N]=boundary[4];subject to gy:y[N]=boundary[5];
subject to gt:atan2(sin(theta[N]-boundary[6]),cos(theta[N]-boundary[6]))=0;
subject to gv:v[N]=0;subject to gp:phi[N]=0;subject to ga:a[N]=0;subject to gw:omega[N]=0;
subject to trust_x{i in 1..N}:rx[i]-dr[i]<=x[i]<=rx[i]+dr[i];
subject to trust_y{i in 1..N}:ry[i]-dr[i]<=y[i]<=ry[i]+dr[i];
subject to trust_theta{i in 1..N}:rt[i]-da[i]<=theta[i]<=rt[i]+da[i];
var epx{j in 1..NE}=x[ei[j]]+cos(theta[ei[j]])*ex[j]-sin(theta[ei[j]])*ey[j];
var epy{j in 1..NE}=y[ei[j]]+sin(theta[ei[j]])*ex[j]+cos(theta[ei[j]])*ey[j];
subject to ego_outside{j in 1..NE}:ea[j]*epx[j]+eb[j]*epy[j]>=ec[j];
var opx{j in 1..NO}=(ox[j]-x[oi[j]])*cos(theta[oi[j]])+(oy[j]-y[oi[j]])*sin(theta[oi[j]]);
var opy{j in 1..NO}=-(ox[j]-x[oi[j]])*sin(theta[oi[j]])+(oy[j]-y[oi[j]])*cos(theta[oi[j]]);
subject to obstacle_outside{j in 1..NO}:oa[j]*opx[j]+ob[j]*opy[j]>=oc[j];
