# Zhang et al. (2021), equations (7), (9), (17) and Appendix A.
param N integer >=2;param E integer >=0;param S integer >=1;
param lw;param vmax;param amax;param phimax;param wmax;param jerkmax;
param alpha >=1;param min_time;param max_time;param segment_threshold;
param bx{1..4};param body_y{1..4};param boundary{1..6};
param n1{1..S} integer;param n2{1..S} integer;param j1{1..S} integer;param j2{1..S} integer;
param cx{1..E};param cy{1..E};param dx{1..E};param dy{1..E};
var h >=min_time/N,<=max_time/N;
var x{0..N};var y{0..N};var theta{0..N};var v{0..N} >=-vmax,<=vmax;
var a{0..N-1} >=-amax,<=amax;var phi{0..N-1} >=-phimax,<=phimax;
var kap{i in 0..N-1}=tan(phi[i])/lw;
var vm{i in 0..N-1}=v[i]+h/2*a[i];
var ve{i in 0..N-1}=v[i]+h*a[i];
var th2{i in 0..N-1}=theta[i]+h/2*v[i]*kap[i];
var th3{i in 0..N-1}=theta[i]+h/2*vm[i]*kap[i];
var th4{i in 0..N-1}=theta[i]+h*vm[i]*kap[i];
minimize cost:N*h;
subject to x_flow{i in 0..N-1}:x[i+1]=x[i]+h/6*(v[i]*cos(theta[i])+2*vm[i]*cos(th2[i])+2*vm[i]*cos(th3[i])+ve[i]*cos(th4[i]));
subject to y_flow{i in 0..N-1}:y[i+1]=y[i]+h/6*(v[i]*sin(theta[i])+2*vm[i]*sin(th2[i])+2*vm[i]*sin(th3[i])+ve[i]*sin(th4[i]));
subject to theta_flow{i in 0..N-1}:theta[i+1]=theta[i]+h*vm[i]*kap[i];
subject to velocity_flow{i in 0..N-1}:v[i+1]=ve[i];
subject to jerk{i in 0..N-2}:-jerkmax<=(a[i+1]-a[i])/h<=jerkmax;
subject to steering_rate{i in 0..N-2}:-wmax<=(phi[i+1]-phi[i])/h<=wmax;
subject to start_x:x[0]=boundary[1];subject to start_y:y[0]=boundary[2];
subject to start_theta:atan2(sin(theta[0]-boundary[3]),cos(theta[0]-boundary[3]))=0;
subject to start_v:v[0]=0;
subject to goal_x:x[N]=boundary[4];subject to goal_y:y[N]=boundary[5];
subject to goal_theta:atan2(sin(theta[N]-boundary[6]),cos(theta[N]-boundary[6]))=0;
subject to goal_v:v[N]=0;
var px{i in 0..N,j in 1..4}=x[i]+cos(theta[i])*bx[j]-sin(theta[i])*alpha*body_y[j];
var py{i in 0..N,j in 1..4}=y[i]+sin(theta[i])*bx[j]+cos(theta[i])*alpha*body_y[j];
var ax{s in 1..S}=px[n1[s],j1[s]];var ay{s in 1..S}=py[n1[s],j1[s]];
var ex{s in 1..S}=px[n2[s],j2[s]];var ey{s in 1..S}=py[n2[s],j2[s]];
var d1{s in 1..S,e in 1..E}=(ax[s]-cx[e])*(dy[e]-cy[e])-(ay[s]-cy[e])*(dx[e]-cx[e]);
var d2{s in 1..S,e in 1..E}=(ex[s]-cx[e])*(dy[e]-cy[e])-(ey[s]-cy[e])*(dx[e]-cx[e]);
var d3{s in 1..S,e in 1..E}=(cx[e]-ax[s])*(ey[s]-ay[s])-(cy[e]-ay[s])*(ex[s]-ax[s]);
var d4{s in 1..S,e in 1..E}=(dx[e]-ax[s])*(ey[s]-ay[s])-(dy[e]-ay[s])*(ex[s]-ax[s]);
subject to disjoint{s in 1..S,e in 1..E}:max(d1[s,e]*d2[s,e],d3[s,e]*d4[s,e])>=segment_threshold;
